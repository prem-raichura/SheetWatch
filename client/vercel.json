{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://sheet-watch-api.vercel.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sheet-watch-api.vercel.app/api/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://sheet-watch-api.vercel.app/public/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://sheet-watch-api.vercel.app/healthz"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
