# Base URL of the SheetWatch API (server package).
#
# Local dev: the API runs on its own port.
VITE_API_BASE_URL=http://localhost:4000
#
# Production: leave this EMPTY. The Vercel client project rewrites /api, /auth
# and /public to the API deployment (see client/vercel.json), so the browser
# only ever talks to its own origin — which keeps the session cookie first-party
# and therefore working in Safari and on iOS. See DEPLOY.md.

# Web-push public key — must match the server's VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=
